// The account store. `npx prisma migrate dev` from apps/api after any change.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  // The API is CommonJS; the default ESM client cannot be required from it.
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

/// Identity is verified once, before the account can hold money or trade.
enum UserStatus {
  unverified
  verified

  @@map("user_status")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  fullName     String     @map("full_name")
  /// Normalized: trimmed and lower-cased.
  email        String     @unique
  /// E.164, +856 followed by the national digits.
  phone        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(unverified)
  /// When the customer accepted the terms. An account cannot exist without it.
  acceptedTermsAt DateTime @map("accepted_terms_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  kycSubmissions KycSubmission[]
  transfers      Transfer[]
  cashEntries    CashEntry[]

  @@map("users")
}

/// Laos' first-level divisions: 17 provinces and the capital prefecture.
enum ProvinceKind {
  prefecture
  province

  @@map("province_kind")
}

/// Reference data, seeded by its migration and not written to at runtime.
model Province {
  /// What other tables reference. Stable across environments and independent
  /// of romanization, which varies — the name is for display, never for joins.
  code String       @id
  name String       @unique
  kind ProvinceKind
 
  kycSubmissions KycSubmission[]

  @@map("provinces")
}

/// Where the money a customer invests comes from — the question Lao
/// anti-money-laundering rules actually ask. Reference data, like provinces.
model FundSource {
  code  String @id
  label String @unique
  /// Not alphabetical: salary first because it is the common answer.
  position Int @map("position")

  kycSubmissions KycSubmission[]

  @@map("fund_sources")
}

enum KycStatus {
  in_review
  approved
  rejected

  @@map("kyc_status")
}

enum DocumentType {
  national_id
  passport

  @@map("document_type")
}

enum DocumentKind {
  id_front
  id_back
  passport_page
  selfie

  @@map("document_kind")
}

/// One identity check, as it was submitted.
///
/// The details are a snapshot rather than fields on the user: the reviewer
/// compares them against the document photographed at that moment, and a
/// rejected customer who re-submits with a corrected spelling leaves two
/// attempts on the record, not an overwrite.
model KycSubmission {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// What the customer is told to quote. Shown once, on the review screen.
  reference String    @unique
  status    KycStatus @default(in_review)

  fullName       String   @map("full_name")
  dateOfBirth    DateTime @map("date_of_birth") @db.Date
  village        String
  district       String
  provinceCode   String   @map("province_code")
  fundSourceCode String   @map("fund_source_code")

  documentType DocumentType @map("document_type")
  /// The highest-value field in this table and the only one stored in the
  /// clear. Encrypting it is a migration away; what the U.S. broker needs to
  /// receive decides which form that takes.
  documentNumber String @map("document_number")

  submittedAt DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  reviewedAt  DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewNote  String?   @map("review_note")
  /// When this row and its photos may be destroyed. Set from KYC_RETENTION_DAYS
  /// so the retention period is a regulatory decision, not a constant in code.
  purgeAfter DateTime @map("purge_after") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  province   Province      @relation(fields: [provinceCode], references: [code])
  fundSource FundSource    @relation(fields: [fundSourceCode], references: [code])
  documents  KycDocument[]

  /// The customer's own history, newest first.
  @@index([userId, submittedAt])
  /// The reviewer's queue.
  @@index([status, submittedAt])
  @@map("kyc_submissions")
}

/// A photo backing a submission. The bytes live in Google Cloud Storage; this
/// row is the pointer to them plus what is needed to check one was not swapped.
model KycDocument {
  id           String       @id @default(uuid()) @db.Uuid
  submissionId String       @map("submission_id") @db.Uuid
  kind         DocumentKind
  /// The object name in the bucket. Never a URL, never the bytes.
  storageKey  String   @map("storage_key")
  contentType String   @map("content_type")
  byteSize    Int      @map("byte_size")
  /// As the bucket reports it — base64 MD5 for Google Cloud Storage. Read back
  /// from storage at submission, never taken from the request.
  checksum   String
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  submission KycSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  /// A passport has one photo page, an ID card has two sides — either way, one
  /// row per kind. The database enforces it, not just the form.
  @@unique([submissionId, kind])
  @@map("kyc_documents")
}

/// A kip-to-dollar rate as it stood at one moment.
///
/// Rows are only ever added. A transfer points at the row it used, so a
/// receipt from last month keeps the numbers it was issued with however far
/// the rate moves afterwards.
model FxRate {
  id String @id @default(uuid()) @db.Uuid
  /// How many kip one U.S. dollar buys.
  usdLak     Decimal  @map("usd_lak") @db.Decimal(18, 6)
  /// The desk, bank or feed it came from.
  source     String
  observedAt DateTime @map("observed_at") @db.Timestamptz(3)

  transfers Transfer[]

  @@index([observedAt])
  @@map("fx_rates")
}

enum Currency {
  lak
  usd

  @@map("currency")
}

enum TransferKind {
  deposit
  withdrawal

  @@map("transfer_kind")
}

enum TransferStatus {
  pending
  settled
  failed

  @@map("transfer_status")
}

/// Money on its way in or out: kip on one side, dollars on the other, and the
/// exact rate that joined them.
model Transfer {
  id     String         @id @default(uuid()) @db.Uuid
  userId String         @map("user_id") @db.Uuid
  kind   TransferKind
  status TransferStatus @default(pending)
  /// What the customer quotes when they ask where their money is.
  reference String @unique

  amountKip Decimal @map("amount_kip") @db.Decimal(20, 2)
  amountUsd Decimal @map("amount_usd") @db.Decimal(18, 2)
  /// Which side the customer typed. The other was derived from the rate.
  enteredIn Currency @map("entered_in")
  fxRateId  String   @map("fx_rate_id") @db.Uuid

  requestedAt   DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  settledAt     DateTime? @map("settled_at") @db.Timestamptz(3)
  failureReason String?   @map("failure_reason")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  fxRate      FxRate      @relation(fields: [fxRateId], references: [id])
  cashEntries CashEntry[]

  /// The customer's own history, newest first.
  @@index([userId, requestedAt])
  /// The operations queue.
  @@index([status, requestedAt])
  @@map("transfers")
}

enum CashEntryKind {
  deposit
  withdrawal
  withdrawal_reversal
  adjustment

  @@map("cash_entry_kind")
}

/// The dollar ledger.
///
/// Append-only, and the balance is the sum of these rows — never a column that
/// gets overwritten. A wallet with a mutable `balance` loses money silently;
/// this way every movement carries the reason it happened and the thing that
/// caused it, so a wrong total can be traced to the row that made it wrong.
model CashEntry {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  /// Signed: credits positive, debits negative.
  amountUsd   Decimal       @map("amount_usd") @db.Decimal(18, 2)
  kind        CashEntryKind
  transferId  String?       @map("transfer_id") @db.Uuid
  description String
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  transfer Transfer? @relation(fields: [transferId], references: [id])

  @@index([userId, createdAt])
  @@map("cash_entries")
}
