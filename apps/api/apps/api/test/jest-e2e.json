{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "@app/shared": "<rootDir>/../../../libs/shared/src",
    "@app/shared/(.*)": "<rootDir>/../../../libs/shared/src/$1",
    "^@db$": "<rootDir>/../../../generated/prisma/client",
    "^@db/(.*)$": "<rootDir>/../../../generated/prisma/$1"
  },
  "setupFiles": [
    "<rootDir>/e2e-env.ts"
  ]
}
