# Copy to .env. Nest reads it from the working directory of `nest start`,
# which is apps/api; the Prisma CLI reads it through prisma7.config.ts.

# Both databases live in the container `npm run db:up` starts; compose.yaml
# creates them. The credentials are local-only and match compose.yaml.
DATABASE_URL="postgresql://siriinvest:siriinvest@localhost:5434/siriinvest_dev?schema=public"

# The end-to-end suite runs against this one and empties it between runs, so
# it must never be the development database. `npm run db:test:setup` migrates it.
TEST_DATABASE_URL="postgresql://siriinvest:siriinvest@localhost:5434/siriinvest_test?schema=public"

# Signs every access token. Required in production; without it the API falls
# back to a development secret and says so, loudly, on every boot.
JWT_SECRET=

# Where identity documents go. The API never holds the bytes: it hands the
# browser a signed URL, the browser PUTs straight to the bucket, and the API
# reads the object back to see what really landed.
GCS_BUCKET=

# Optional. Without a key file the client uses Application Default Credentials
# (`gcloud auth application-default login`, or the service account a deployed
# instance already runs as).
GCS_PROJECT_ID=
GCS_KEY_FILE=

# How long an upload URL stays good for, in seconds. Defaults to 900.
GCS_UPLOAD_URL_TTL_SECONDS=900

# How long an identity check and its photos are kept, in days. The default is
# five years, a common anti-money-laundering period and a placeholder until
# someone reads the Lao rule — this is a regulatory answer, not a technical one.
KYC_RETENTION_DAYS=1825

# How long an access token stays good for, in seconds. Defaults to 3600.
JWT_TTL_SECONDS=3600

# The browser origin allowed to call this API. Defaults to the web dev server.
WEB_ORIGIN=http://localhost:3000

PORT=3001
