# Copy to .env.local. Server-side only — used by Server Components (the
# province and fund-source lists), so this is deliberately not a
# NEXT_PUBLIC_ variable.
API_URL=http://localhost:3001

# Sign-up, sign-in and the KYC calls run from the browser, so this one does
# ship to the client. Same API, a different variable, because a deployed web
# app may reach it by a different address than a Server Component does.
NEXT_PUBLIC_API_URL=http://localhost:3001
